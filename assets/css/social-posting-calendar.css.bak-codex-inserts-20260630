.bbb-social-calendar {
	--bbb-sc-bg: #080808;
	--bbb-sc-bg-2: #111;
	--bbb-sc-surface: rgba(22, 22, 22, 0.94);
	--bbb-sc-surface-strong: rgba(31, 31, 31, 0.98);
	--bbb-sc-tile: rgba(255, 255, 255, 0.055);
	--bbb-sc-line: rgba(255, 255, 255, 0.12);
	--bbb-sc-line-strong: rgba(255, 255, 255, 0.28);
	--bbb-sc-ink: #f7f7f7;
	--bbb-sc-muted: #a9a9a9;
	--bbb-sc-soft: #e8e8e8;
	--bbb-sc-platform-threads: #f05a9d;
	--bbb-sc-platform-pinterest: #e60023;
	--bbb-sc-platform-tiktok: #35f2e6;
	--bbb-sc-platform-instagram: #c06cff;
	--bbb-sc-platform-email: #7da7ff;
	--bbb-sc-platform-substack: #ff8a00;
	--bbb-sc-status-scheduled: #35b36f;
	--bbb-sc-status-staged: #f2c94c;
	--bbb-sc-status-missing: #ff6060;
	--bbb-sc-status-draft: #d9d9d9;
	background: linear-gradient(145deg, var(--bbb-sc-bg), var(--bbb-sc-bg-2));
	color: var(--bbb-sc-ink);
	font-family: "DM Sans", system-ui, sans-serif;
	min-height: 100vh;
	padding: clamp(24px, 4vw, 52px);
}

html {
	height: auto;
	min-height: 100%;
	position: static;
	overflow-x: hidden;
	overflow-y: auto;
}

.bbb-social-planner-app-shell {
	background: #080808;
	height: auto;
	margin: 0;
	min-height: 100%;
	overscroll-behavior: none;
	overflow-x: hidden;
	overflow-y: auto;
	position: static;
	-webkit-overflow-scrolling: touch;
}

.bbb-social-calendar--app {
	padding: max(16px, env(safe-area-inset-top)) max(12px, env(safe-area-inset-right)) max(18px, env(safe-area-inset-bottom)) max(12px, env(safe-area-inset-left));
}

.bbb-social-calendar--app .bbb-social-calendar__hero {
	margin-bottom: 14px;
}

.bbb-social-calendar--app h1 {
	font-size: clamp(2.15rem, 8vw, 4rem);
}

.bbb-social-calendar--app .bbb-social-calendar__hero p:not(.bbb-social-calendar__eyebrow) {
	margin-top: 8px;
}

.bbb-social-calendar * {
	box-sizing: border-box;
}

.bbb-social-calendar__hero,
.bbb-social-calendar__layout,
.bbb-social-calendar__embeds,
.bbb-social-calendar__settings {
	margin: 0 auto;
	max-width: 1480px;
}

.bbb-social-calendar__hero {
	align-items: end;
	display: grid;
	gap: 20px;
	grid-template-columns: minmax(0, 1fr);
	margin-bottom: 24px;
}

.bbb-social-calendar__eyebrow {
	color: var(--bbb-sc-muted);
	font-size: 0.75rem;
	font-weight: 800;
	letter-spacing: 0;
	margin: 0 0 8px;
	text-transform: uppercase;
}

.bbb-social-calendar h1,
.bbb-social-calendar h2 {
	color: var(--bbb-sc-ink);
	font-family: "Playfair Display", Georgia, serif;
	letter-spacing: 0;
	margin: 0;
}

.bbb-social-calendar h1 {
	font-size: clamp(2.5rem, 5vw, 5rem);
	line-height: 0.94;
}

.bbb-social-calendar__hero p:not(.bbb-social-calendar__eyebrow) {
	color: var(--bbb-sc-muted);
	font-size: 1.02rem;
	margin: 14px 0 0;
	max-width: 720px;
}

.bbb-social-calendar__status,
.bbb-social-calendar__notice,
.bbb-social-calendar__panel,
.bbb-social-calendar__main,
.bbb-social-calendar__settings form,
.bbb-social-calendar__embed {
	background: var(--bbb-sc-surface);
	border: 1px solid var(--bbb-sc-line);
	border-radius: 8px;
	box-shadow: 0 18px 56px rgba(0, 0, 0, 0.38);
}

.bbb-social-calendar__status,
.bbb-social-calendar__panel,
.bbb-social-calendar__settings form,
.bbb-social-calendar__embed {
	padding: 18px;
}

.bbb-social-calendar__status strong,
.bbb-social-calendar__status span {
	display: block;
}

.bbb-social-calendar__status strong {
	color: var(--bbb-sc-soft);
}

.bbb-social-calendar__status span,
.bbb-social-calendar__settings p {
	color: var(--bbb-sc-muted);
	font-size: 0.9rem;
	margin-top: 4px;
}

.bbb-social-calendar__notice {
	border-color: rgba(53, 179, 111, 0.45);
	color: #8ce2b3;
	margin: 0 auto 18px;
	max-width: 1480px;
	padding: 12px 14px;
}

.bbb-social-calendar__layout {
	align-items: start;
	display: grid;
	gap: 18px;
	grid-template-columns: minmax(0, 1fr);
}

.bbb-social-calendar__main {
	min-width: 0;
	padding: 14px;
}

.bbb-social-calendar__toolbar {
	align-items: center;
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
	justify-content: space-between;
	margin-bottom: 14px;
}

.bbb-social-calendar__toolbarActions {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
	justify-content: flex-end;
}

.bbb-social-calendar button,
.bbb-social-calendar__toolbar button {
	background: #f5f5f5;
	border: 1px solid #f5f5f5;
	border-radius: 8px;
	color: #101010;
	cursor: pointer;
	font: inherit;
	font-weight: 800;
	min-height: 42px;
	padding: 10px 14px;
}

.bbb-social-calendar__toolbar button {
	background: rgba(255, 255, 255, 0.06);
	border-color: var(--bbb-sc-line);
	color: var(--bbb-sc-soft);
}

.bbb-social-calendar__toolbar span {
	color: var(--bbb-sc-soft);
	font-size: 0.86rem;
	font-weight: 900;
	text-transform: uppercase;
}

.bbb-social-calendar__toolbar button.is-active,
.bbb-social-calendar__toolbar button:focus-visible,
.bbb-social-calendar__toolbar button:hover {
	background: #fff;
	border-color: #fff;
	color: #050505;
}

.bbb-social-calendar__saveNow {
	background: #ff7ab8;
	border-color: #ff7ab8;
	color: #050505;
}

.bbb-social-calendar__saveNow.is-saved {
	background: #35b36f;
	border-color: #35b36f;
	color: #050505;
}

.bbb-social-calendar__saveNow.is-error {
	background: #ff6060;
	border-color: #ff6060;
	color: #050505;
}

.bbb-social-calendar__saveNow:disabled {
	cursor: wait;
	opacity: 0.74;
}

.bbb-social-calendar__saveStatus {
	color: var(--bbb-sc-muted);
	flex-basis: 100%;
	font-size: 0.78rem;
	font-weight: 800;
	overflow-wrap: anywhere;
	text-align: right;
}

.bbb-social-calendar__saveStatus.is-error {
	color: #ff9aa8;
}

.bbb-social-calendar__calendar {
	min-height: 860px;
}

.bbb-social-calendar.is-visual-mode .bbb-social-calendar__calendar,
.bbb-social-calendar.is-visual-mode [data-calendar-today] {
	display: none !important;
}

.bbb-social-calendar.is-calendar-mode .bbb-social-calendar__visual {
	display: none !important;
}

.bbb-social-calendar__visual[hidden] {
	display: none;
}

.bbb-social-calendar__visual {
	display: grid;
	gap: 14px;
	min-height: 760px;
}

.bbb-social-calendar__visualHead {
	align-items: end;
	display: flex;
	gap: 14px;
	justify-content: space-between;
}

.bbb-social-calendar__visualHead h2 {
	font-size: clamp(1.7rem, 3vw, 2.5rem);
	line-height: 1;
}

.bbb-social-calendar__weekNav,
.bbb-social-calendar__platformTabs {
	align-items: flex-start;
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
}

.bbb-social-calendar__weekNav {
	justify-content: flex-end;
}

.bbb-social-calendar__platformTabs button {
	background: rgba(255, 255, 255, 0.06);
	border-color: var(--bbb-sc-line);
	color: var(--bbb-sc-soft);
	height: 56px;
	min-height: 56px;
}

.bbb-social-calendar__platformTabs button.is-active,
.bbb-social-calendar__platformTabs button:hover,
.bbb-social-calendar__platformTabs button:focus-visible {
	background: var(--bbb-sc-ink);
	border-color: var(--bbb-sc-ink);
	color: var(--bbb-sc-bg);
}

.bbb-social-calendar__visualGrid {
	align-items: start;
	display: grid;
	gap: 10px;
	grid-template-columns: repeat(8, minmax(160px, 1fr));
	overscroll-behavior-x: contain;
	overscroll-behavior-y: auto;
	overflow-x: auto;
	overflow-y: visible;
	padding-bottom: 6px;
	touch-action: pan-x pan-y;
}

.bbb-social-calendar__visualGrid[hidden],
.bbb-social-calendar__platformTabs[hidden],
.bbb-social-calendar__pinReview[hidden] {
	display: none;
}

.bbb-social-calendar__pinReview {
	align-content: start;
	display: grid;
	gap: 14px;
	min-height: 0;
	overflow: visible;
	padding-bottom: 32px;
}

.bbb-social-calendar--app .bbb-social-calendar__pinReview:not([hidden]) {
	max-height: calc(100dvh - 240px);
	overscroll-behavior: contain;
	overflow-x: hidden;
	overflow-y: auto;
	padding-right: 4px;
	-webkit-overflow-scrolling: touch;
}

.bbb-social-calendar__reviewTabs {
	display: flex;
	flex-wrap: wrap;
	gap: 8px;
}

.bbb-social-calendar__reviewTabs button {
	background: rgba(255, 255, 255, 0.07);
	border-color: var(--bbb-sc-line);
	color: var(--bbb-sc-soft);
}

.bbb-social-calendar__reviewTabs button.is-active,
.bbb-social-calendar__reviewTabs button:hover,
.bbb-social-calendar__reviewTabs button:focus-visible {
	background: #fff;
	border-color: #fff;
	color: #050505;
}

.bbb-social-calendar__pinReviewDay {
	display: grid;
	gap: 10px;
}

.bbb-social-calendar__pinReviewDay h3 {
	color: #fff;
	font-family: "Playfair Display", Georgia, serif;
	font-size: 1.45rem;
	line-height: 1;
	margin: 0;
}

.bbb-social-calendar__pinReviewCard {
	background: #f7f7f7;
	border: 1px solid rgba(255, 255, 255, 0.16);
	border-radius: 8px;
	color: #050505;
	display: grid;
	gap: 12px;
	grid-template-columns: 180px 1fr;
	padding: 12px;
}

.bbb-social-calendar__pinReviewCard.is-queued,
.bbb-social-calendar__pinReviewCard.is-scheduled {
	background: #ecfff3;
	border-color: rgba(53, 179, 111, 0.72);
	box-shadow: inset 0 0 0 2px rgba(53, 179, 111, 0.18);
}

.bbb-social-calendar__pinReviewCard.is-staged {
	background: #fff8db;
	border-color: rgba(242, 201, 76, 0.86);
	box-shadow: inset 0 0 0 2px rgba(242, 201, 76, 0.24);
}

.bbb-social-calendar__pinReviewCard.is-missing {
	background: #fff0f0;
	border-color: rgba(255, 96, 96, 0.72);
}

.bbb-social-calendar__pinReviewCard.is-published {
	background: #050505;
	border-color: rgba(255, 255, 255, 0.52);
	box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.16);
	color: #fff;
}

.bbb-social-calendar__instagramReviewCard {
	border-color: rgba(192, 108, 255, 0.42);
}

.bbb-social-calendar__reviewActions {
	align-items: center;
	display: flex;
	flex-wrap: wrap;
	gap: 10px;
}

.bbb-social-calendar__reviewSave {
	align-self: start;
	background: #050505;
	border: 0;
	border-radius: 8px;
	color: #fff;
	cursor: pointer;
	font-weight: 950;
	letter-spacing: 0;
	min-height: 42px;
	padding: 10px 14px;
	text-transform: lowercase;
}

.bbb-social-calendar__reviewSend {
	background: var(--bbb-sc-status-scheduled);
}

.bbb-social-calendar__reviewSave:disabled {
	cursor: wait;
	opacity: 0.72;
}

.bbb-social-calendar__pinReviewTime {
	background: #050505;
	border-radius: 8px;
	color: #fff;
	font-size: 0.82rem;
	font-weight: 950;
	margin-bottom: 10px;
	padding: 9px 10px;
	text-transform: uppercase;
}

.bbb-social-calendar__pinReviewCard.is-queued .bbb-social-calendar__pinReviewTime,
.bbb-social-calendar__pinReviewCard.is-scheduled .bbb-social-calendar__pinReviewTime {
	background: #1f8f4f;
}

.bbb-social-calendar__pinReviewCard.is-staged .bbb-social-calendar__pinReviewTime {
	background: #8a6800;
}

.bbb-social-calendar__pinReviewCard.is-missing .bbb-social-calendar__pinReviewTime {
	background: #9d2626;
}

.bbb-social-calendar__pinReviewCard.is-published .bbb-social-calendar__pinReviewTime {
	background: #fff;
	color: #050505;
}

.bbb-social-calendar__pinReviewCard.is-published .bbb-social-calendar__pinReviewFields span {
	color: #d8d8d8;
}

.bbb-social-calendar__pinReviewTime span {
	background: rgba(255, 255, 255, 0.18);
	border-radius: 999px;
	display: inline-block;
	margin-left: 8px;
	padding: 4px 7px;
}

.bbb-social-calendar__pinReviewImage {
	align-items: center;
	background: #e8e8e8;
	border-radius: 8px;
	display: flex;
	justify-content: center;
	min-height: 230px;
	overflow: hidden;
}

.bbb-social-calendar__pinReviewImage img {
	display: block;
	height: auto;
	width: 100%;
}

.bbb-social-calendar__pinReviewImage span {
	color: #707070;
	font-weight: 900;
}

.bbb-social-calendar__pinReviewUpload {
	background: #050505;
	border-color: #050505;
	color: #ffd7eb;
	margin-top: 8px;
	width: 100%;
}

.bbb-social-calendar__pinReviewUpload:hover,
.bbb-social-calendar__pinReviewUpload:focus-within {
	background: #222;
	border-color: #222;
	outline: 2px solid rgba(255, 154, 210, 0.28);
}

.bbb-social-calendar__pinReviewFields {
	display: grid;
	gap: 9px;
}

.bbb-social-calendar__pinReviewFields label {
	display: grid;
	gap: 5px;
}

.bbb-social-calendar__pinReviewFields span {
	color: #555;
	font-size: 0.72rem;
	font-weight: 950;
	text-transform: uppercase;
}

.bbb-social-calendar__pinReviewFields input,
.bbb-social-calendar__pinReviewFields textarea,
.bbb-social-calendar__pinReviewFields select {
	background: #fff;
	border: 1px solid #d8d8d8;
	border-radius: 8px;
	color: #050505;
	font: inherit;
	font-size: 0.9rem;
	line-height: 1.38;
	min-height: 40px;
	padding: 9px 10px;
	width: 100%;
}

.bbb-social-calendar__pinReviewFields textarea {
	resize: vertical;
}

.bbb-social-calendar__instagramReviewAssets {
	display: grid;
	gap: 10px;
	grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
}

.bbb-social-calendar__instagramReviewAsset {
	background: #fff;
	border: 1px solid #dedede;
	border-radius: 8px;
	display: grid;
	gap: 9px;
	padding: 9px;
}

.bbb-social-calendar__instagramReviewAsset .bbb-social-calendar__pinReviewImage {
	min-height: 210px;
}

.bbb-social-calendar__instagramReviewSlideHead {
	align-items: center;
	display: flex;
	gap: 8px;
	justify-content: space-between;
}

.bbb-social-calendar__instagramReviewSlideHead strong {
	color: #050505;
	font-size: 0.78rem;
	font-weight: 950;
	text-transform: uppercase;
}

.bbb-social-calendar__instagramReviewSlideHead span {
	display: flex;
	gap: 6px;
}

.bbb-social-calendar__instagramReviewSlideHead button {
	background: #f1f1f1;
	border-color: #d8d8d8;
	color: #050505;
	font-size: 0.72rem;
	min-height: 32px;
	padding: 6px 8px;
}

.bbb-social-calendar__reviewEmpty {
	background: #fff;
	border: 1px solid #dedede;
	border-radius: 8px;
	color: #555;
	font-weight: 900;
	margin: 0;
	padding: 14px;
}

.bbb-social-calendar__pinReviewFields input:focus,
.bbb-social-calendar__pinReviewFields textarea:focus,
.bbb-social-calendar__pinReviewFields select:focus {
	border-color: #050505;
	outline: 2px solid rgba(5, 5, 5, 0.12);
}

.bbb-social-calendar__visualDay {
	background: rgba(255, 255, 255, 0.045);
	border: 1px solid var(--bbb-sc-line);
	border-radius: 8px;
	display: grid;
	gap: 10px;
	min-height: 660px;
	min-width: 160px;
	padding: 10px;
}

.bbb-social-calendar__visualDay.is-today {
	border-color: rgba(240, 90, 157, 0.78);
	box-shadow: inset 0 0 0 1px rgba(240, 90, 157, 0.48);
}

.bbb-social-calendar__visualDay.is-sunday {
	background: rgba(86, 166, 255, 0.16);
	border-color: rgba(86, 166, 255, 0.72);
	box-shadow: inset 0 0 0 1px rgba(86, 166, 255, 0.34);
}

.bbb-social-calendar__visualDay.is-sunday.is-today {
	box-shadow: inset 0 0 0 2px rgba(86, 166, 255, 0.78), inset 0 0 0 5px rgba(240, 90, 157, 0.54);
}

.bbb-social-calendar__visualDay.is-complete {
	background: rgba(53, 179, 111, 0.16);
	border-color: rgba(53, 179, 111, 0.72);
	box-shadow: inset 0 0 0 1px rgba(53, 179, 111, 0.34);
}

.bbb-social-calendar__visualDay.is-complete.is-today {
	box-shadow: inset 0 0 0 2px rgba(53, 179, 111, 0.78), inset 0 0 0 5px rgba(240, 90, 157, 0.54);
}

.bbb-social-calendar__visualDay.is-thread-empty {
	align-content: start;
	gap: 6px;
	height: 86px !important;
	max-height: 86px !important;
	min-height: 86px;
	padding: 8px;
}

.bbb-social-calendar__visualDay.is-thread-missing {
	align-content: start;
	background: rgba(157, 38, 38, 0.34);
	border-color: rgba(255, 96, 96, 0.86);
	box-shadow: inset 0 0 0 2px rgba(255, 96, 96, 0.3);
	grid-auto-rows: auto;
	grid-template-rows: auto auto;
	height: 178px !important;
	max-height: 178px !important;
	min-height: 178px !important;
	overflow: hidden;
}

.bbb-social-calendar__visualDay.is-thread-filled {
	align-content: start;
	background: rgba(31, 143, 79, 0.32);
	border-color: rgba(53, 179, 111, 0.9);
	box-shadow: inset 0 0 0 2px rgba(53, 179, 111, 0.34);
	grid-auto-rows: auto;
	grid-template-rows: auto auto;
	height: 178px !important;
	max-height: 178px !important;
	min-height: 178px !important;
	overflow: hidden;
}

.bbb-social-calendar__visualDay.is-thread-missing.is-today {
	box-shadow: inset 0 0 0 2px rgba(255, 96, 96, 0.78), inset 0 0 0 5px rgba(240, 90, 157, 0.54);
}

.bbb-social-calendar__visualDay.is-thread-filled.is-today {
	box-shadow: inset 0 0 0 2px rgba(53, 179, 111, 0.78), inset 0 0 0 5px rgba(240, 90, 157, 0.54);
}

.bbb-social-calendar__visualDay header {
	display: grid;
	gap: 4px;
	min-height: 50px;
}

.bbb-social-calendar__visualDay header span {
	color: var(--bbb-sc-muted);
	font-size: 0.76rem;
	font-weight: 900;
	text-transform: uppercase;
}

.bbb-social-calendar__visualDay header strong {
	color: var(--bbb-sc-ink);
	font-size: 0.9rem;
	line-height: 1.12;
}

.bbb-social-calendar__dayStatus {
	align-items: center;
	background: rgba(255, 255, 255, 0.08);
	border: 1px solid rgba(255, 255, 255, 0.12);
	border-radius: 999px;
	color: #ffd7eb;
	display: inline-flex;
	font-size: 0.68rem;
	font-style: normal;
	font-weight: 950;
	justify-content: center;
	line-height: 1;
	min-height: 24px;
	padding: 5px 8px;
	text-transform: uppercase;
	width: fit-content;
}

.bbb-social-calendar__visualDay.is-complete .bbb-social-calendar__dayStatus {
	background: rgba(53, 179, 111, 0.22);
	border-color: rgba(53, 179, 111, 0.58);
	color: #8ce2b3;
}

.bbb-social-calendar__boardSelect {
	display: grid;
	gap: 6px;
}

.bbb-social-calendar__boardSelect span {
	color: var(--bbb-sc-muted);
	font-size: 0.74rem;
	font-weight: 900;
	text-transform: uppercase;
}

.bbb-social-calendar__boardSelect.is-empty span {
	color: #ff8585;
}

.bbb-social-calendar__boardSelect.is-filled span {
	color: #8ce2b3;
}

.bbb-social-calendar__boardSelect select {
	appearance: none;
	background: rgba(255, 96, 96, 0.14);
	border: 1px solid rgba(255, 96, 96, 0.72);
	border-radius: 8px;
	color: #ffd0d0;
	font: inherit;
	font-size: 0.8rem;
	font-weight: 800;
	min-height: 40px;
	padding: 8px 10px;
	width: 100%;
}

.bbb-social-calendar__boardSelect.is-filled select {
	background: rgba(53, 179, 111, 0.17);
	border-color: rgba(53, 179, 111, 0.76);
	color: #d8ffe7;
}

.bbb-social-calendar__boardSelect select:focus {
	border-color: var(--bbb-sc-line-strong);
	outline: 2px solid rgba(255, 255, 255, 0.12);
}

.bbb-social-calendar__visualDrop {
	align-content: start;
	background: rgba(0, 0, 0, 0.22);
	border: 1px dashed rgba(255, 255, 255, 0.18);
	border-radius: 8px;
	display: grid;
	gap: 9px;
	min-height: 320px;
	padding: 8px;
	transition: border-color 140ms ease, background 140ms ease;
}

.bbb-social-calendar__visualDrop.is-dragging {
	background: rgba(230, 0, 35, 0.12);
	border-color: var(--bbb-sc-platform-pinterest);
}

.bbb-social-calendar__visualAssets {
	display: grid;
	gap: 8px;
}

.bbb-social-calendar__pinSlot {
	background: rgba(255, 255, 255, 0.04);
	border: 1px solid rgba(255, 255, 255, 0.12);
	border-radius: 8px;
	color: var(--bbb-sc-muted);
	display: grid;
