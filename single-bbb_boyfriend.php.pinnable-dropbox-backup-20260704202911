	get_footer();
	return;
}

the_post();

$post_id = get_the_ID();
$profile_url = get_permalink($post_id);
$profile_image_url = (string) get_the_post_thumbnail_url($post_id, 'full');
$book_id = bbb_fictional_boyfriend_primary_book_id($post_id);
$source  = (string) get_post_meta($post_id, '_bbb_fb_source', true);
$author  = (string) get_post_meta($post_id, '_bbb_fb_author', true);
$series  = (string) get_post_meta($post_id, '_bbb_fb_series', true);
$shelf   = (string) get_post_meta($post_id, '_bbb_fb_shelf', true);
$tropes  = bbb_fictional_boyfriend_tropes($post_id);
$traits  = bbb_fictional_boyfriend_traits($post_id);
$spice   = bbb_fictional_boyfriend_spice($post_id);
$series_post = bbb_fictional_boyfriend_series_post($post_id);
$series_name = $series_post instanceof WP_Post ? get_the_title($series_post) : $series;
$series_url = $series_post instanceof WP_Post ? get_permalink($series_post) : '';
$verdict = trim((string) get_post_meta($post_id, '_bbb_fb_one_line_profile', true));
if ('' === $verdict) {
	$verdict = trim((string) get_the_excerpt());
}
$pinterest_title = function_exists('bbb_fictional_boyfriend_pinterest_title')
	? bbb_fictional_boyfriend_pinterest_title($post_id)
	: trim(wp_strip_all_tags(get_the_title($post_id) . ' fictional boyfriend profile'));
$pinterest_description = function_exists('bbb_fictional_boyfriend_pinterest_description')
	? bbb_fictional_boyfriend_pinterest_description($post_id)
	: trim(wp_strip_all_tags($verdict ?: get_the_title($post_id)));
$pinterest_save_url = $profile_image_url
	? add_query_arg(
		array(
			'url'         => $profile_url,
			'media'       => $profile_image_url,
			'title'       => $pinterest_title,
			'description' => $pinterest_description,
		),
		'https://www.pinterest.com/pin/create/button/'
	)
	: '';
$book_url = $book_id ? get_permalink($book_id) : '';
$book_title = $book_id ? get_the_title($book_id) : $source;
$society_subscribe_url = function_exists('bbb_substack_subscribe_url') ? bbb_substack_subscribe_url() : 'https://thesmutandsentimentsociety.substack.com/subscribe';
$book_cover = '';
if ($book_id) {
	$book_cover = (string) get_the_post_thumbnail_url($book_id, 'full');
	if ('' === $book_cover && function_exists('bbb_get_book_cover_url')) {
		$book_cover = (string) bbb_get_book_cover_url($book_id);
	}
}
$book_review_post = null;
if ($book_id) {
	$book_review_post = function_exists('bbb_article_book_connections_review_post_for_book')
		? bbb_article_book_connections_review_post_for_book($book_id)
		: null;
}
$love_language = trim((string) get_post_meta($post_id, '_bbb_fb_love_language', true));
$would_text_back = trim((string) get_post_meta($post_id, '_bbb_fb_would_text_back', true));
$read_next_note = trim((string) get_post_meta($post_id, '_bbb_fb_read_next_note', true));
$trait_scores = bbb_fictional_boyfriend_trait_scores($post_id);
$raw_content = (string) get_post_field('post_content', $post_id);
$content_faq_shortcode = '';
$main_content = preg_replace_callback(
	'/<!--\s+wp:shortcode\s+-->\s*(\[faq\b[^\]]*\].*?\[\/faq\])\s*<!--\s+\/wp:shortcode\s+-->/is',
	static function (array $matches) use (&$content_faq_shortcode): string {
		if ('' === $content_faq_shortcode) {
			$content_faq_shortcode = $matches[1];
		}
		return '';
	},
	$raw_content
);
if (null === $main_content) {
	$main_content = $raw_content;
}
$main_content = preg_replace_callback(
	'/\[faq\b[^\]]*\].*?\[\/faq\]/is',
	static function (array $matches) use (&$content_faq_shortcode): string {
		if ('' === $content_faq_shortcode) {
			$content_faq_shortcode = $matches[0];
		}
		return '';
	},
	$main_content
);
if (null === $main_content) {
	$main_content = $raw_content;
}
$related_books = array();
if ($book_id && function_exists('bbb_books_like_recommendations')) {
	foreach (bbb_books_like_recommendations($book_id) as $book) {
		if (count($related_books) >= 3 || empty($book['id'])) {
			continue;
		}
		$related_post = get_post((int) $book['id']);
		if ($related_post instanceof WP_Post) {
			$related_data = function_exists('sss_book_data') ? sss_book_data($related_post) : array();
			$related_cover = (string) ($related_data['cover'] ?? '');
			if ('' !== $related_cover && function_exists('bbb_normalize_url_value')) {
				$related_cover = bbb_normalize_url_value($related_cover);
			}
			$related_tropes = (array) ($related_data['tropes'] ?? array());
			$first_trope = $related_tropes[0] ?? array();
			$first_trope_name = (string) ($first_trope['name'] ?? '');
			$first_trope_html = '' !== $first_trope_name && function_exists('bbb_trope_label_html')
				? bbb_trope_label_html($first_trope_name, $first_trope['emoji'] ?? '', (string) ($first_trope['handle'] ?? $first_trope_name))
				: esc_html($first_trope_name);
			$related_books[] = array(
				'post' => $related_post,
				'handle' => (string) ($related_data['handle'] ?? $related_post->post_name),
				'title' => (string) ($related_data['title'] ?? get_the_title($related_post)),
				'author' => (string) ($related_data['author'] ?? ''),
				'cover' => $related_cover,
				'amazon' => (string) ($related_data['amazon'] ?? ''),
				'bookshop' => (string) ($related_data['bookshop'] ?? ''),
				'spice' => (int) ($related_data['spice'] ?? get_post_meta($related_post->ID, '_bbb_spice', true)),
				'shelf' => (string) ($related_data['shelf'] ?? ''),
				'trope' => $first_trope_name,
				'trope_html' => $first_trope_html,
				'tropes' => implode(', ', array_filter(array_map(static fn(array $trope): string => (string) ($trope['name'] ?? ''), $related_tropes))),
				'mini' => (string) ($related_data['mini'] ?? ''),
				'ku' => !empty($related_data['ku']),
				'url' => get_permalink($related_post),
			);
		}
	}
}
$related_boyfriends = bbb_fictional_boyfriend_related($post_id, 3);
$series_boyfriends = function_exists('bbb_fictional_boyfriend_series_siblings') ? bbb_fictional_boyfriend_series_siblings($post_id, 3) : array();
$quote_posts = bbb_fictional_boyfriend_quotes($post_id, 6);
$quote_teasers = array_slice($quote_posts, 0, 3);
$quote_wall_book_id = $book_id;
if (!$quote_wall_book_id && $quote_teasers && function_exists('bbb_quote_wall_book')) {
	$quote_wall_book = bbb_quote_wall_book($quote_teasers[0]);
	$quote_wall_book_id = $quote_wall_book instanceof WP_Post ? (int) $quote_wall_book->ID : 0;
}
if (!$quote_wall_book_id && '' !== trim($source)) {
	$quote_source_slug = sanitize_title($source);
	$quote_book_types = function_exists('bbb_quote_book_post_types') ? bbb_quote_book_post_types() : array('bbb_book');
	foreach ($quote_book_types as $quote_book_type) {
		$quote_wall_book = get_page_by_path($quote_source_slug, OBJECT, $quote_book_type);
		if ($quote_wall_book instanceof WP_Post) {
			$quote_wall_book_id = (int) $quote_wall_book->ID;
			break;
		}
	}
}
$quote_wall_url = $quote_wall_book_id && function_exists('bbb_book_quotes_url') ? bbb_book_quotes_url($quote_wall_book_id) : home_url('/sss-quote-wall/');
if ('' === $book_cover && $quote_wall_book_id) {
	$quote_wall_cover = (string) get_the_post_thumbnail_url($quote_wall_book_id, 'full');
	if ('' === $quote_wall_cover && function_exists('bbb_get_book_cover_url')) {
		$quote_wall_cover = (string) bbb_get_book_cover_url($quote_wall_book_id);
	}
	if ('' !== $quote_wall_cover) {
		$book_cover = $quote_wall_cover;
		$book_url = $book_url ?: (string) get_permalink($quote_wall_book_id);
		$book_title = get_the_title($quote_wall_book_id) ?: $book_title;
	}
}
$pinterest_links = function_exists('bbb_fictional_boyfriend_pinterest_links') ? bbb_fictional_boyfriend_pinterest_links($post_id) : array();
$character_name = trim(wp_strip_all_tags(get_the_title($post_id)));
$aesthetic_book_title = trim(wp_strip_all_tags((string) ($book_title ?: $source)));
$aesthetic_trope = $tropes[0] ?? 'dark romance';
$aesthetic_alt = trim(
	sprintf(
		'%1$s dark romance moodboard - morally gray book boyfriend%2$s',
		$character_name,
		$aesthetic_book_title ? ' from ' . $aesthetic_book_title : ''
	)
);
$aesthetic_pin_description = trim(
	sprintf(
		'%1$s aesthetic | dark romance | morally gray book boyfriend | enemies to lovers%2$s%3$s',
		$character_name,
		$aesthetic_book_title ? ' | ' . $aesthetic_book_title : '',
		$aesthetic_trope ? ' | ' . $aesthetic_trope : ''
	)
);
$aesthetic_tiles = array();
$aesthetic_dropbox_tiles = array();
$aesthetic_uploaded_tiles = array();
$aesthetic_external_tiles = array();
$dropbox_tiles = function_exists('bbb_dropbox_fictional_boyfriend_images') ? bbb_dropbox_fictional_boyfriend_images((int) $post_id, 3) : array();
foreach ($dropbox_tiles as $dropbox_tile) {
	$dropbox_media_url = (string) ($dropbox_tile['media'] ?? '');
	if ('' === $dropbox_media_url) {
		continue;
	}

	$aesthetic_dropbox_tiles[] = array(
		'media' => $dropbox_media_url,
		'source' => (string) ($dropbox_tile['source'] ?? $profile_url),
		'alt' => (string) ($dropbox_tile['alt'] ?? $aesthetic_alt),
	);
}
foreach ($pinterest_links as $index => $pin_url) {
	$pin_parts = array_map('trim', explode('|', $pin_url, 2));
	$pin_media_url = (string) ($pin_parts[0] ?? '');
	$pin_source_url = (string) ($pin_parts[1] ?? $pin_media_url);
	$is_image_url = (bool) preg_match('/\.(?:avif|gif|jpe?g|png|webp)(?:\?.*)?$/i', $pin_media_url);
	if (!$is_image_url) {
		continue;
	}
	$tile = array(
		'media' => $pin_media_url,
		'source' => $pin_source_url,
	);
	if (0 === strpos($pin_media_url, home_url('/'))) {
		$aesthetic_uploaded_tiles[] = $tile;
	} else {
		$aesthetic_external_tiles[] = $tile;
	}
}
$aesthetic_tiles = array_merge($aesthetic_dropbox_tiles, $aesthetic_uploaded_tiles, $aesthetic_external_tiles);
$aesthetic_tiles = array_slice($aesthetic_tiles, 0, 3);
$aesthetic_has_media = static function (array $tiles, string $media_url): bool {
	$media_url = trim($media_url);
	if ('' === $media_url) {
		return true;
	}

	foreach ($tiles as $tile) {
		if ($media_url === trim((string) ($tile['media'] ?? ''))) {
			return true;
		}
	}

	return false;
};
if (count($aesthetic_tiles) < 3 && '' !== $book_cover && !$aesthetic_has_media($aesthetic_tiles, $book_cover)) {
	$aesthetic_tiles[] = array(
		'media'           => $book_cover,
		'source'          => $book_url ?: $profile_url,
		'alt'             => trim(($book_title ?: $source ?: $character_name) . ' book cover'),
		'pin_title'       => trim(($book_title ?: $source ?: $character_name) . ' book cover'),
		'pin_description' => trim(
			sprintf(
				'Save the %1$s book cover from %2$s%3$s.',
				$book_title ?: $source ?: $character_name,
				$character_name,
				$aesthetic_trope ? ' | ' . $aesthetic_trope : ''
			)
		),
	);
}
$aesthetic_quote_tile = null;
if (function_exists('bbb_quote_pin_card_url') && $quote_posts) {
	$aesthetic_quote_rotations = array();
	foreach ($quote_posts as $quote) {
		if (!$quote instanceof WP_Post) {
			continue;
		}

		$quote_text = bbb_quote_pin_quote_text($quote);
		if ('' === $quote_text) {
			continue;
		}

		$quote_pin_args = array(
			'context'   => 'boyfriend',
			'source_id' => $post_id,
		);
		$aesthetic_quote_rotations[] = array(
			'media' => bbb_quote_pin_card_url($quote, $quote_pin_args),
			'alt'   => bbb_quote_pin_title($quote, $quote_pin_args),
			'title' => bbb_quote_pin_title($quote, $quote_pin_args),
			'description' => bbb_quote_pin_description($quote, $quote_pin_args),
		);
	}

	if ($aesthetic_quote_rotations) {
		$first_quote_tile = $aesthetic_quote_rotations[0];
		$aesthetic_quote_tile = array(
			'media'           => (string) $first_quote_tile['media'],
			'source'          => $profile_url,
			'alt'             => (string) $first_quote_tile['alt'],
			'pin_title'       => (string) $first_quote_tile['title'],
			'pin_description' => (string) $first_quote_tile['description'],
			'rotations'       => $aesthetic_quote_rotations,
		);
	}
}
if ($aesthetic_quote_tile && count($aesthetic_tiles) < 3) {
	$aesthetic_side_tiles = array_slice($aesthetic_tiles, 0, 2);
	$aesthetic_tiles = array();
	if (!empty($aesthetic_side_tiles[0])) {
		$aesthetic_tiles[0] = $aesthetic_side_tiles[0];
	}
	$aesthetic_tiles[1] = $aesthetic_quote_tile;
	if (!empty($aesthetic_side_tiles[1])) {
		$aesthetic_tiles[2] = $aesthetic_side_tiles[1];
	}
}

$needs_note = static function (string $label): void {
	?>
	<div class="bbb-fb-note-needed">
		<p><?php echo esc_html($label); ?> needs your note before this section goes final.</p>
	</div>
