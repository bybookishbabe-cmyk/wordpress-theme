};

$bar = static function (string $label, int $value): void {
	$value = max(0, min(10, $value));
	?>
	<div class="bbb-fb-bar">
		<span><?php echo esc_html($label); ?></span>
		<i><b style="width: <?php echo esc_attr((string) ($value * 10)); ?>%"></b></i>
		<em><?php echo esc_html((string) $value); ?>/10</em>
	</div>
	<?php
};

